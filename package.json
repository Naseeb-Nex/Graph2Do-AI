{
  "name": "graph2do",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev --",
    "build": "npm --prefix apps/web run build",
    "test": "npm --prefix apps/web test && pytest apps/api/tests",
    "test:frontend": "npm --prefix apps/web test",
    "test:backend": "pytest apps/api/tests",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}
