# Local default; PostgreSQL is also supported.
DATABASE_URL=sqlite:///./graph2do.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Kinde backend configuration
KINDE_DOMAIN=https://your-app.kinde.com
KINDE_CLIENT_ID=your_backend_client_id
KINDE_CLIENT_SECRET=your_backend_client_secret
KINDE_CALLBACK_URL=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:3000
